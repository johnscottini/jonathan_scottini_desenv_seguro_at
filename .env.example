# Modelo das variáveis de ambiente. Copie para .env e preencha com valores reais.
# O .env é ignorado pelo versionamento e nunca deve ser commitado.

DATABASE_URL=sqlite:///./agendamento.db

# Gerar com: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=troque-por-um-valor-aleatorio-longo
ALGORITHM=HS256
JWT_ISSUER=agendamento-api
JWT_AUDIENCE=agendamento-api
ACCESS_TOKEN_EXPIRE_MINUTES=30
M2M_TOKEN_EXPIRE_MINUTES=15

ADMIN_USERNAME=admin
ADMIN_PASSWORD=troque-esta-senha

LAB_CLIENT_ID=laboratorio-parceiro
LAB_CLIENT_SECRET=troque-este-segredo

# true em produção (HTTPS). false apenas para rodar localmente em http://.
COOKIE_SECURE=true
