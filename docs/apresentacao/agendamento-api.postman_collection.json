                  "  pm.expect([201, 409]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{tokenAdmin}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"dra.ana\",\n  \"nome\": \"Dra. Ana Costa\",\n  \"password\": \"{{senhaPadrao}}\",\n  \"papel\": \"profissional\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/admin/usuarios", "host": ["{{baseUrl}}"], "path": ["admin", "usuarios"] },
            "description": "O campo 'papel' so existe nesta rota. O cadastro publico (POST /usuarios) nao tem esse campo no schema, entao nao da para se autopromover pela rota aberta. Vale como resposta de arguicao."
